@page
@model AshishPortfolio.Web.Pages.IndexModel
@{
    Layout = null;
    ViewData["Title"] = $"{Model.Data.DeveloperName} | Full-Stack .NET Developer";
}

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />

    <style>
        body {
            background-color: #ECEEF2;
            color: #1E293B;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        .clay-card {
            background: #FFFFFF;
            border-radius: 2rem;
            box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.04), 0 2px 6px -1px rgba(0, 0, 0, 0.02);
            border: 1px solid rgba(226, 232, 240, 0.8);
        }

        .clay-card-dark {
            background: #0B0F19;
            border-radius: 2.5rem;
            box-shadow: 0 20px 40px -10px rgba(11, 15, 25, 0.4);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        .roadmap-connector {
            position: relative;
        }

            .roadmap-connector::before {
                content: '';
                position: absolute;
                top: 2rem;
                bottom: 2rem;
                left: 2.25rem;
                width: 3px;
                background: linear-gradient(to bottom, #3B82F6, #8B5CF6, #EC4899, #10B981);
                z-index: 0;
            }
    </style>
</head>
<body class="min-h-screen selection:bg-slate-900 selection:text-white pb-16">

    <!-- TOP HEADER -->
    <header class="sticky top-0 z-50 bg-[#ECEEF2]/90 backdrop-blur-md border-b border-slate-300/60">
        <div class="max-w-6xl mx-auto px-4 sm:px-8 h-20 flex items-center justify-between">
            <a href="/" class="flex items-center gap-3 group">
                <div class="w-11 h-11 rounded-full overflow-hidden border-2 border-slate-800 bg-slate-900 shadow-md group-hover:scale-105 transition duration-300 shrink-0">
                    <img src="/ashish.png" alt="@Model.Data.DeveloperName" class="w-full h-full object-cover object-top" onerror="this.src='/portrait.png'" />
                </div>
                <div>
                    <span class="font-extrabold text-base tracking-tight text-slate-900 block leading-tight">@Model.Data.DeveloperName</span>
                    <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider block">Portfolio (.NET Engine)</span>
                </div>
            </a>

            <nav class="hidden md:flex items-center gap-8 text-xs font-bold uppercase tracking-wider text-slate-600">
                <a href="#about" class="hover:text-slate-950 transition">About</a>
                <a href="#evolution-arc" class="hover:text-slate-950 transition">Engineering Arc</a>
                <a href="#tech-roadmap" class="hover:text-slate-950 transition">Tech Roadmap</a>
                <a href="#projects" class="hover:text-slate-950 transition">20+ Systems</a>
                <a href="#experience" class="hover:text-slate-950 transition">Impact</a>
                <a href="#contact" class="hover:text-slate-950 transition">Contact</a>
            </nav>

            <div class="flex items-center gap-3">
                <a href="/Resume" class="px-4 py-2 rounded-xl bg-white border border-slate-300 text-xs font-bold text-slate-700 hover:border-slate-400 transition shadow-sm">
                    ATS Resume
                </a>
                <a href="#contact" class="px-5 py-2 rounded-xl bg-slate-900 text-white text-xs font-bold hover:bg-slate-800 transition shadow-md">
                    Hire Me
                </a>
            </div>
        </div>
    </header>

    <main class="max-w-6xl mx-auto px-4 sm:px-8 space-y-12 pt-8">

        <!-- 1. HERO SECTION -->
        <section class="clay-card p-8 sm:p-12 relative overflow-hidden">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
                <div class="lg:col-span-8 space-y-6">
                    <div class="space-y-2">
                        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 border border-blue-200 text-blue-700 text-xs font-bold font-mono">
                            <span class="w-2 h-2 rounded-full bg-blue-600 animate-pulse"></span>
                            Available for Full-Stack .NET &amp; Cloud Roles
                        </div>
                        <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
                            Hello I'm <span class="text-blue-600">@Model.Data.DeveloperName</span>
                        </h1>
                        <p class="text-lg sm:text-xl font-bold text-slate-700">
                            @Model.Data.PrimaryRole
                        </p>
                    </div>

                    <p class="text-slate-600 text-sm leading-relaxed max-w-2xl">
                        Building high-concurrency, resilient, and mission-critical enterprise applications with C#, ASP.NET Core, Angular, SQL Server, and Azure. Proven delivery across Fortune 500 accounts at Wipro, CHS Inc., and Tapestry.
                    </p>

                    <div class="flex flex-wrap gap-4 pt-2">
                        <a href="#projects" class="px-6 py-3.5 rounded-2xl bg-slate-900 text-white text-xs font-bold tracking-wider uppercase hover:bg-slate-800 transition shadow-md">
                            View 20+ Systems
                        </a>
                        <a href="#evolution-arc" class="px-6 py-3.5 rounded-2xl bg-slate-100 text-slate-800 text-xs font-bold tracking-wider uppercase hover:bg-slate-200 transition">
                            Explore Engineering Arc
                        </a>
                    </div>
                </div>

                <div class="lg:col-span-4 grid grid-cols-1 gap-3">
                    <div class="bg-slate-50 p-4 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
                        <div>
                            <span class="text-[10px] uppercase font-mono font-bold text-slate-400 block">Experience</span>
                            <span class="text-lg font-extrabold text-slate-900">@Model.Data.ExperienceSpan</span>
                        </div>
                        <i data-lucide="calendar" class="w-6 h-6 text-blue-600"></i>
                    </div>
                    <div class="bg-slate-50 p-4 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
                        <div>
                            <span class="text-[10px] uppercase font-mono font-bold text-slate-400 block">Systems Shipped</span>
                            <span class="text-lg font-extrabold text-slate-900">20+ Applications</span>
                        </div>
                        <i data-lucide="layers" class="w-6 h-6 text-purple-600"></i>
                    </div>
                    <div class="bg-slate-50 p-4 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
                        <div>
                            <span class="text-[10px] uppercase font-mono font-bold text-slate-400 block">Notice Period</span>
                            <span class="text-lg font-extrabold text-emerald-600">@Model.Data.NoticePeriod</span>
                        </div>
                        <i data-lucide="check-circle" class="w-6 h-6 text-emerald-600"></i>
                    </div>
                </div>
            </div>
        </section>

        <!-- 2. ENGINEERING ARC (Ray Lines on Left, `portrait.png` Cutout on Right) -->
        <section id="evolution-arc" class="clay-card-dark p-8 sm:p-14 space-y-10 text-white relative overflow-hidden">
            <div class="text-center space-y-2">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-blue-400 text-xs font-mono font-bold uppercase tracking-wider">
                    <i data-lucide="milestone" class="w-4 h-4"></i> Career &amp; Capabilities Arc
                </div>
                <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight">Milestones That Defined My Engineering</h2>
                <p class="text-xs sm:text-sm text-slate-400 max-w-xl mx-auto">
                    A visual walkthrough of key architectural phases, technical breakthroughs, and production problem-solving.
                </p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center pt-4">

                <!-- Left Side: Milestone Rays -->
                <div class="lg:col-span-7 space-y-4 order-2 lg:order-1">
                    <div class="p-4 rounded-2xl bg-white/5 border border-white/10 hover:border-blue-500/50 transition flex items-start gap-4">
                        <span class="px-2.5 py-1 bg-blue-500/20 text-blue-400 text-xs font-mono font-bold rounded-lg shrink-0 mt-0.5">2022</span>
                        <div class="space-y-0.5">
                            <h4 class="text-sm font-bold text-white">Academic Foundation &amp; Enterprise Support Trainee</h4>
                            <p class="text-xs text-slate-400 leading-relaxed">
                                Completed B.Sc. IT and stepped into 24/7 SQL Server production operations at Coach Inc., diagnosing Tidal ETL batch timeouts and turning incidents into durable C# fixes.
                            </p>
                        </div>
                    </div>

                    <div class="p-4 rounded-2xl bg-white/5 border border-white/10 hover:border-purple-500/50 transition flex items-start gap-4">
                        <span class="px-2.5 py-1 bg-purple-500/20 text-purple-400 text-xs font-mono font-bold rounded-lg shrink-0 mt-0.5">JAN 2023</span>
                        <div class="space-y-0.5">
                            <h4 class="text-sm font-bold text-white">High-Volume E-Commerce Checkout Optimization</h4>
                            <p class="text-xs text-slate-400 leading-relaxed">
                                Enhanced live production order-flow, inventory synchronization, and payment gateways on .NET Core for Tapestry Inc., authoring tuned SQL procedures that eliminated database deadlocks.
                            </p>
                        </div>
                    </div>

                    <div class="p-4 rounded-2xl bg-white/5 border border-white/10 hover:border-emerald-500/50 transition flex items-start gap-4">
                        <span class="px-2.5 py-1 bg-emerald-500/20 text-emerald-400 text-xs font-mono font-bold rounded-lg shrink-0 mt-0.5">AUG 2023</span>
                        <div class="space-y-0.5">
                            <h4 class="text-sm font-bold text-white">Mission-Critical PlanetPress JDE Middleware</h4>
                            <p class="text-xs text-slate-400 leading-relaxed">
                                Engineered C# automation middleware pulling files from JDE, parsing datasets, and routing documents/emails directly—cutting execution turnaround from 30–40 minutes to mere seconds.
                            </p>
                        </div>
                    </div>

                    <div class="p-4 rounded-2xl bg-white/5 border border-white/10 hover:border-amber-500/50 transition flex items-start gap-4">
                        <span class="px-2.5 py-1 bg-amber-500/20 text-amber-400 text-xs font-mono font-bold rounded-lg shrink-0 mt-0.5">2024+</span>
                        <div class="space-y-0.5">
                            <h4 class="text-sm font-bold text-white">Shine Ecosystem, Reporting Hub &amp; Multi-Tenant Platforms</h4>
                            <p class="text-xs text-slate-400 leading-relaxed">
                                Built daily compliance reporting portals with automated email triggers, shift-roster constraint solvers, and multi-tenant platforms (ASpynix, nexuS, PANKH) with automated CI/CD.
                            </p>
                        </div>
                    </div>

                    <div class="p-4 rounded-2xl bg-white/5 border border-white/10 hover:border-sky-500/50 transition flex items-start gap-4">
                        <span class="px-2.5 py-1 bg-sky-500/20 text-sky-400 text-xs font-mono font-bold rounded-lg shrink-0 mt-0.5">NOW</span>
                        <div class="space-y-0.5">
                            <h4 class="text-sm font-bold text-white">Applied AI, Distributed Caching &amp; Systems Architecture</h4>
                            <p class="text-xs text-slate-400 leading-relaxed">
                                Integrating Azure OpenAI services, Redis caching layers, Clean Architecture, and high-performance Web APIs for modern distributed applications.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Right Side: Cutout Frame (`portrait.png`) -->
                <div class="lg:col-span-5 flex flex-col items-center justify-center relative order-1 lg:order-2">
                    <div class="absolute w-72 h-72 sm:w-80 sm:h-80 rounded-full bg-gradient-to-tr from-blue-600/20 via-purple-600/10 to-transparent blur-2xl pointer-events-none"></div>

                    <div class="relative w-72 sm:w-88 flex flex-col items-center">
                        <img src="/portrait.png" alt="@Model.Data.DeveloperName" class="w-full h-auto max-h-[460px] object-contain drop-shadow-[0_20px_30px_rgba(0,0,0,0.8)]" onerror="this.src='/portrait.jpg'" />

                        <div class="mt-2 bg-slate-900/90 backdrop-blur-md px-5 py-3 rounded-2xl border border-slate-700/80 text-center shadow-xl w-full max-w-[280px]">
                            <span class="text-xs font-extrabold uppercase tracking-wider text-blue-400 font-mono block">Ashish Kumar Pathak</span>
                            <span class="text-[10px] text-slate-400 font-mono block mt-0.5">Full-Stack .NET Developer</span>
                        </div>
                    </div>
                </div>

            </div>
        </section>

        <!-- 3. TECH STACK ROADMAP -->
        <section id="tech-roadmap" class="clay-card-dark p-8 sm:p-12 space-y-10 text-white">
            <div class="text-center space-y-3">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-blue-400 text-xs font-mono font-bold uppercase tracking-wider">
                    <i data-lucide="compass" class="w-4 h-4"></i> Architecture Blueprint
                </div>
                <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight">Full-Stack .NET Roadmap</h2>
                <p class="text-xs sm:text-sm text-slate-400 max-w-xl mx-auto">
                    A comprehensive stack spanning frontend, middleware integration, .NET backend, database performance tuning, CI/CD, schedulers, and Applied AI.
                </p>
            </div>

            <div class="roadmap-connector space-y-6 relative max-w-4xl mx-auto">
                @foreach (var phase in Model.Data.Roadmap)
                {
                <div class="relative z-10 flex items-start gap-4 sm:gap-6">
                    <div class="w-12 h-12 rounded-2xl @phase.AccentColor flex items-center justify-center font-extrabold text-xs font-mono shadow-lg shrink-0 mt-2">
                        <i data-lucide="check" class="w-5 h-5"></i>
                    </div>

                    <div class="flex-1 bg-white/5 border border-white/10 rounded-2xl p-5 sm:p-6 space-y-4 hover:border-white/20 transition">
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 border-b border-white/10 pb-3">
                            <div>
                                <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-blue-400 block">@phase.PhaseNumber</span>
                                <h3 class="text-lg font-bold text-white">@phase.PhaseTitle</h3>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
                            @foreach (var tech in phase.Technologies)
                                {
                            <div class="bg-white/[0.03] border border-white/5 rounded-xl p-3 flex items-center gap-3 hover:bg-white/[0.08] transition">
                                <div class="w-8 h-8 rounded-lg bg-blue-500/20 text-blue-400 flex items-center justify-center shrink-0">
                                    <i data-lucide="@tech.Icon" class="w-4 h-4"></i>
                                </div>
                                <div class="overflow-hidden">
                                    <span class="text-xs font-bold text-white block truncate">@tech.Name</span>
                                    <span class="text-[10px] text-slate-400 block truncate font-mono">@tech.Role</span>
                                </div>
                            </div>
                                }
                        </div>
                    </div>
                </div>
                }
            </div>
        </section>

        <!-- 4. PROJECT SHOWCASE (With Matching Business-Specific Preview Images) -->
        <section id="projects" class="space-y-6">
            <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 px-2">
                <div>
                    <span class="text-xs font-bold uppercase tracking-widest text-slate-400 font-mono">Systems Portfolio</span>
                    <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900">20+ Featured Systems &amp; Platforms</h2>
                </div>
                <span class="text-xs font-mono font-bold text-slate-500">Enterprise • SaaS • Logistics • Commerce</span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                @foreach (var proj in Model.Data.AllProjects)
                {
                <div class="clay-card p-6 flex flex-col justify-between hover:shadow-xl transition duration-300 space-y-4">

                    <div class="grid grid-cols-1 sm:grid-cols-12 gap-4 items-start">
                        <div class="sm:col-span-7 space-y-2">
                            <div class="flex items-center gap-2">
                                <span class="w-6 h-6 rounded-lg bg-slate-900 text-white font-mono font-bold text-xs flex items-center justify-center">
                                    @proj.Id
                                </span>
                                <span class="px-2 py-0.5 rounded bg-slate-100 text-slate-700 font-mono text-[10px] font-bold uppercase">
                                    @proj.Category
                                </span>
                            </div>
                            <h3 class="text-base font-extrabold text-slate-900 leading-tight">
                                @proj.Title
                            </h3>
                            <p class="text-xs text-slate-600 leading-relaxed">
                                @proj.Summary
                            </p>
                        </div>

                        <!-- Right Visual Mockup with Business Specific Preview Image -->
                        <div class="sm:col-span-5 h-28 rounded-2xl overflow-hidden shadow-inner border border-slate-200 relative group">
                            <img src="@proj.ImageUrl" alt="@proj.Title" class="w-full h-full object-cover group-hover:scale-105 transition duration-500" />
                            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent p-2.5 flex flex-col justify-between text-white">
                                <div class="flex items-center justify-between text-[9px] font-mono opacity-90">
                                    <span class="bg-black/50 px-1.5 py-0.5 rounded backdrop-blur-xs">@proj.Domain</span>
                                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                                </div>
                                <span class="text-[10px] text-emerald-400 font-mono font-bold block truncate">@proj.MetricTag</span>
                            </div>
                        </div>
                    </div>

                    <div class="pt-3 border-t border-slate-100 flex flex-wrap items-center justify-between gap-2">
                        <div class="flex flex-wrap gap-1">
                            @foreach (var tech in proj.TechStack)
                                {
                            <span class="text-[10px] font-mono font-semibold px-2 py-0.5 bg-slate-100 rounded text-slate-700">@tech</span>
                                }
                        </div>
                        <span class="text-[11px] font-mono font-bold text-blue-600">@proj.MetricTag</span>
                    </div>

                </div>
                }
            </div>
        </section>

        <!-- 5. ENTERPRISE EXPERIENCE & IMPACT DASHBOARD -->
        <section id="experience" class="clay-card p-8 sm:p-12 space-y-10">
            <div class="space-y-2">
                <span class="text-xs font-bold uppercase tracking-widest text-slate-400 font-mono">Production Track Record</span>
                <h2 class="text-3xl font-extrabold text-slate-900">Documented Enterprise Impact</h2>
                <p class="text-xs text-slate-500 max-w-2xl leading-relaxed">
                    Production engineering deliverables, internal automation tools, and performance metrics across enterprise environments.
                </p>
            </div>

            <div class="space-y-8">
                @foreach (var exp in Model.Data.WorkHistory)
                {
                <div class="p-6 sm:p-8 bg-slate-50/70 rounded-3xl border border-slate-200 space-y-6">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-200/80 pb-4">
                        <div>
                            <span class="text-xs font-mono font-bold text-blue-600 uppercase">@exp.Period</span>
                            <h3 class="text-xl font-extrabold text-slate-950">@exp.RoleTitle — @exp.Organization</h3>
                            <p class="text-xs font-semibold text-slate-500">Client: @exp.ClientName</p>
                        </div>
                        <span class="px-3 py-1 rounded-full bg-slate-900 text-white font-mono text-xs font-bold self-start sm:self-center">
                            Enterprise Account
                        </span>
                    </div>

                    <div>
                        <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 font-mono block mb-3">Key Impact Metrics &amp; System Results:</span>
                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
                            @foreach (var m in exp.Metrics)
                                {
                            <div class="bg-white p-4 rounded-2xl border border-slate-200/90 shadow-sm flex flex-col justify-between space-y-2">
                                <div>
                                    <span class="text-xl font-extrabold font-mono text-slate-900 block">@m.Value</span>
                                    <span class="text-[11px] font-bold text-blue-600 uppercase tracking-wider block">@m.Label</span>
                                    <span class="text-[10px] text-slate-500 leading-tight block mt-0.5">@m.Subtitle</span>
                                </div>
                                <div class="w-full bg-slate-100 h-1.5 rounded-full overflow-hidden mt-1">
                                    <div class="bg-gradient-to-r from-blue-500 to-emerald-500 h-full rounded-full" style="width: @(m.MetricPercent)%"></div>
                                </div>
                            </div>
                                }
                        </div>
                    </div>

                    <div class="space-y-2 pt-2">
                        <span class="text-xs font-bold uppercase tracking-wider text-slate-700 block font-mono">Core Engineering Deliverables:</span>
                        <ul class="text-xs text-slate-600 space-y-2 leading-relaxed">
                            @foreach (var item in exp.CoreDeliverables)
                                {
                            <li class="flex items-start gap-2">
                                <i data-lucide="check-circle" class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5"></i>
                                <span>@item</span>
                            </li>
                                }
                        </ul>
                    </div>

                    <div class="flex flex-wrap gap-1.5 pt-2 border-t border-slate-200/60">
                        @foreach (var tech in exp.Stack)
                            {
                        <span class="text-[10px] font-mono px-2.5 py-1 bg-white border border-slate-200 rounded-lg text-slate-800 font-semibold">@tech</span>
                            }
                    </div>
                </div>
                }
            </div>
        </section>

        <!-- 6. CONTACT SECTION -->
        <section id="contact" class="clay-card p-8 sm:p-12 space-y-8">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">

                <div class="lg:col-span-5 space-y-6">
                    <div class="space-y-2">
                        <span class="text-xs font-bold uppercase tracking-widest text-slate-400 font-mono">Let's Collaborate</span>
                        <h2 class="text-3xl font-extrabold text-slate-900">Direct Inquiries &amp; Connect</h2>
                        <p class="text-xs text-slate-600 leading-relaxed">
                            Open for enterprise software positions, technical architecture consultations, and contract software delivery.
                        </p>
                    </div>

                    <div class="space-y-3">
                        <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 font-mono block">Direct Communication Channels</span>

                        <div class="grid grid-cols-2 gap-3">
                            <a href="@Model.Data.WhatsAppUrl" target="_blank" class="flex items-center gap-3 p-3.5 rounded-2xl bg-slate-50 border border-slate-200 hover:border-emerald-500 hover:text-emerald-600 transition shadow-sm">
                                <div class="w-7 h-7 rounded-full bg-emerald-500 text-white flex items-center justify-center shrink-0">
                                    <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                                        <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.18-2.587-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.062-2.18-.553-1.637-.677-2.684-2.34-2.766-2.451-.082-.108-.66-8.79-.66-1.674 0-.794.417-1.185.565-1.344.148-.159.324-.199.432-.199.108 0 .216.002.311.008.099.006.233-.038.365.279.135.324.462 1.127.502 1.209.041.082.068.178.014.286-.054.108-.081.175-.162.27-.081.095-.171.212-.244.285-.081.081-.166.17-.071.334.095.163.421.696.903 1.125.621.553 1.144.724 1.307.805.162.081.257.071.352-.038.095-.108.405-.472.513-.634.108-.163.216-.135.365-.081.148.054.945.446 1.107.527.162.081.27.122.311.189.04.068.04.392-.104.797z" />
                                    </svg>
                                </div>
                                <div>
                                    <span class="text-xs font-bold block">WhatsApp</span>
                                    <span class="text-[10px] text-slate-400">Direct Chat</span>
                                </div>
                            </a>

                            <a href="tel:@Model.Data.Phone" class="flex items-center gap-3 p-3.5 rounded-2xl bg-slate-50 border border-slate-200 hover:border-blue-500 hover:text-blue-600 transition shadow-sm">
                                <div class="w-7 h-7 rounded-full bg-blue-500 text-white flex items-center justify-center shrink-0">
                                    <i data-lucide="phone-call" class="w-3.5 h-3.5"></i>
                                </div>
                                <div>
                                    <span class="text-xs font-bold block">Direct Call</span>
                                    <span class="text-[10px] text-slate-400">@Model.Data.Phone</span>
                                </div>
                            </a>

                            <a href="@Model.Data.LinkedInUrl" target="_blank" class="flex items-center gap-3 p-3.5 rounded-2xl bg-slate-50 border border-slate-200 hover:border-blue-700 hover:text-blue-700 transition shadow-sm">
                                <div class="w-7 h-7 rounded-full bg-[#0A66C2] text-white flex items-center justify-center shrink-0">
                                    <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                                        <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.45a1.6 1.6 0 1 0 0 3.2 1.6 1.6 0 0 0 0-3.2z" />
                                    </svg>
                                </div>
                                <div>
                                    <span class="text-xs font-bold block">LinkedIn</span>
                                    <span class="text-[10px] text-slate-400">Profile</span>
                                </div>
                            </a>

                            <a href="@Model.Data.InstagramUrl" target="_blank" class="flex items-center gap-3 p-3.5 rounded-2xl bg-slate-50 border border-slate-200 hover:border-pink-500 hover:text-pink-600 transition shadow-sm">
                                <div class="w-7 h-7 rounded-full bg-gradient-to-tr from-amber-500 via-pink-500 to-purple-600 text-white flex items-center justify-center shrink-0">
                                    <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                                        <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
                                    </svg>
                                </div>
                                <div>
                                    <span class="text-xs font-bold block">Instagram</span>
                                    <span class="text-[10px] text-slate-400">Social Channel</span>
                                </div>
                            </a>
                        </div>

                        <a href="mailto:@Model.Data.Email" class="flex items-center gap-3 p-3.5 rounded-2xl bg-slate-50 border border-slate-200 hover:border-amber-500 hover:text-amber-600 transition shadow-sm w-full">
                            <div class="w-7 h-7 rounded-full bg-amber-500 text-white flex items-center justify-center shrink-0">
                                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                                    <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z" />
                                </svg>
                            </div>
                            <div>
                                <span class="text-xs font-bold block">Gmail Inquiry</span>
                                <span class="text-[10px] text-slate-500 font-mono">@Model.Data.Email</span>
                            </div>
                        </a>
                    </div>
                </div>

                <!-- AJAX Contact Form Container -->
                <div class="lg:col-span-7 bg-slate-50 border border-slate-200 p-6 sm:p-8 rounded-3xl space-y-4">
                    <div id="form-alert" class="hidden p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-semibold flex items-center gap-3 shadow-sm transition-all duration-300">
                        <i data-lucide="check-circle-2" class="w-5 h-5 text-emerald-600 shrink-0"></i>
                        <span>Thank you! Your message has been sent successfully. Ashish will get back to you shortly.</span>
                    </div>

                    <form id="portfolio-contact-form" onsubmit="handleAjaxContactSubmit(event)" class="space-y-4">
                        <div>
                            <label class="block text-xs font-bold uppercase text-slate-600 mb-1">Your Name</label>
                            <input id="contact-name" name="name" type="text" required placeholder="e.g. Hiring Manager / Client" class="w-full px-4 py-3 rounded-xl border border-slate-300 bg-white text-xs text-slate-800 focus:outline-none focus:border-slate-900" />
                        </div>
                        <div>
                            <label class="block text-xs font-bold uppercase text-slate-600 mb-1">Your Email</label>
                            <input id="contact-email" name="email" type="email" required placeholder="name@company.com" class="w-full px-4 py-3 rounded-xl border border-slate-300 bg-white text-xs text-slate-800 focus:outline-none focus:border-slate-900" />
                        </div>
                        <div>
                            <label class="block text-xs font-bold uppercase text-slate-600 mb-1">Your Message</label>
                            <textarea id="contact-message" name="message" rows="4" required placeholder="Describe your software project or engineering requirements..." class="w-full px-4 py-3 rounded-xl border border-slate-300 bg-white text-xs text-slate-800 focus:outline-none focus:border-slate-900"></textarea>
                        </div>
                        <button id="submit-btn" type="submit" class="w-full py-4 rounded-xl bg-slate-900 text-white text-xs font-bold tracking-wider uppercase hover:bg-slate-800 transition flex items-center justify-center gap-2">
                            <span id="btn-text">Send Direct Message</span>
                            <i id="btn-icon" data-lucide="send" class="w-4 h-4"></i>
                        </button>
                    </form>
                </div>

            </div>
        </section>

    </main>

    <!-- FOOTER -->
    <footer class="max-w-6xl mx-auto px-4 sm:px-8 mt-12 text-center text-xs font-mono text-slate-500">
        © 2026 @Model.Data.DeveloperName. Built with ASP.NET Core &amp; Razor architecture.
    </footer>

    <script>
        lucide.createIcons();

        async function handleAjaxContactSubmit(e) {
            e.preventDefault();
            const submitBtn = document.getElementById('submit-btn');
            const btnText = document.getElementById('btn-text');
            const formAlert = document.getElementById('form-alert');
            const form = document.getElementById('portfolio-contact-form');

            const name = document.getElementById('contact-name').value;
            const email = document.getElementById('contact-email').value;
            const message = document.getElementById('contact-message').value;
            const targetEmail = "pathak.ashishindia@gmail.com";

            submitBtn.disabled = true;
            btnText.innerText = "Dispatching Message...";

            try {
                const response = await fetch("https://formsubmit.co/ajax/" + targetEmail, {
                    method: "POST",
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify({
                        name: name,
                        email: email,
                        message: message,
                        _subject: "New Portfolio Message from " + name
                    })
                });

                formAlert.classList.remove('hidden');
                lucide.createIcons();
                form.reset();

                setTimeout(() => {
                    formAlert.classList.add('hidden');
                }, 5000);

            } catch (err) {
                window.location.href = "mailto:" + targetEmail + "?subject=" + encodeURIComponent("Portfolio Inquiry from " + name) + "&body=" + encodeURIComponent("Sender: " + email + "\n\n" + message);
            } finally {
                submitBtn.disabled = false;
                btnText.innerText = "Send Direct Message";
                lucide.createIcons();
            }
        }
    </script>
</body>
</html>