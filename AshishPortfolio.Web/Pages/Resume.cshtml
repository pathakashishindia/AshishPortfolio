@page "/Resume"
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Official Resume | Ashish Kumar Pathak</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <style>
        body {
            background-color: #0b0f19 !important;
            color: #e2e8f0;
            font-family: system-ui, -apple-system, sans-serif;
        }

        .resume-container {
            max-width: 980px;
            margin: 0 auto;
        }

        .action-bar {
            background: #111827;
            border: 1px solid #1f293d;
            border-radius: 100px;
            padding: 12px 24px;
        }

        .resume-card {
            background: #131b2e;
            border: 1px solid #1f2a44;
            border-radius: 24px;
            box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.6);
        }

        .profile-img-frame {
            width: 105px;
            height: 105px;
            border-radius: 20px;
            object-fit: cover;
            border: 2px solid #38bdf8;
            box-shadow: 0 0 15px rgba(56, 189, 248, 0.25);
            background: #090d16;
        }

        .info-box {
            background: #090d16;
            border: 1px solid #162035;
            border-radius: 16px;
        }

        .section-icon {
            background: #1d2b45;
            color: #38bdf8;
            width: 38px;
            height: 38px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 10px;
        }

        .grid-box {
            background: #0d1424;
            border: 1px solid #192338;
            border-radius: 14px;
        }
    </style>
</head>
<body>

    <div class="py-5">
        <div class="container resume-container">

            <!-- Top Action Bar -->
            <div class="action-bar d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4 shadow">
                <a href="/" class="btn btn-outline-light btn-sm px-4 rounded-pill border-secondary text-light fw-medium">
                    &larr; Back to Portfolio
                </a>
                <div class="d-flex align-items-center gap-3">
                    <span class="badge bg-success bg-opacity-25 text-success border border-success border-opacity-50 px-3 py-2 rounded-pill fw-medium small">
                        &bull; ATS Verified Standard
                    </span>
                    <a href="~/files/Ashish_Kumar_Pathak_Resume.pdf" download class="btn btn-primary btn-sm px-4 py-2 rounded-pill fw-bold shadow">
                        <i class="bi bi-download me-1"></i> Download Official PDF
                    </a>
                </div>
            </div>

            <!-- Main Resume Document -->
            <div class="resume-card p-4 p-md-5">

                <!-- Header Section with Profile Image -->
                <div class="border-bottom border-secondary border-opacity-25 pb-4 mb-4">
                    <div class="row align-items-center g-4">
                        <div class="col-md-7">
                            <div class="d-flex align-items-center gap-4">
                                <img src="~/images/ashish.png"
                                     onerror="this.onerror=null; this.src='/images/profile.png';"
                                     alt="Ashish Kumar Pathak"
                                     class="profile-img-frame flex-shrink-0" />
                                <div>
                                    <h1 class="text-white fw-bolder mb-1 h2">Ashish Kumar Pathak</h1>
                                    <h5 class="text-primary fw-semibold mb-2" style="color: #38bdf8 !important;">Full-Stack Software Engineer &amp; .NET Specialist</h5>
                                    <div class="text-secondary small">
                                        Ranchi, Jharkhand, India &bull; CTO &amp; Co-Founder at ASpynix
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-5">
                            <div class="info-box p-3 small">
                                <div class="d-flex mb-1">
                                    <span class="text-secondary fw-semibold" style="width: 70px;">GitHub:</span>
                                    <a href="https://github.com/pathakashishindia" target="_blank" class="text-info text-decoration-none text-truncate">github.com/pathakashishindia</a>
                                </div>
                                <div class="d-flex mb-1">
                                    <span class="text-secondary fw-semibold" style="width: 70px;">Org:</span>
                                    <a href="https://aspynix.com" target="_blank" class="text-info text-decoration-none">aspynix.com</a>
                                </div>
                                <div class="d-flex">
                                    <span class="text-secondary fw-semibold" style="width: 70px;">Status:</span>
                                    <span class="text-success fw-medium">Available for Senior Roles</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Professional Summary -->
                <div class="mb-5">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="section-icon">
                            <i class="bi bi-file-earmark-person-fill fs-5"></i>
                        </div>
                        <h5 class="text-uppercase fw-bold text-white mb-0">Professional Summary</h5>
                    </div>
                    <p class="text-light text-opacity-75 lh-lg mb-0">
                        Full-Stack Software Engineer with robust expertise in enterprise application development, distributed backend architecture, and database optimization using ASP.NET Core, C#, Entity Framework Core, and Microsoft SQL Server. Proven history of architecting end-to-end multi-tier web platforms, designing resilient RESTful APIs, and implementing automated DevOps pipelines across Azure DevOps, Docker, and cloud web app instances. Co-Founder and CTO driving strategic engineering initiatives from initial database schema creation to zero-downtime global production release.
                    </p>
                </div>

                <!-- Technical Competencies -->
                <div class="mb-5">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="section-icon">
                            <i class="bi bi-cpu-fill fs-5"></i>
                        </div>
                        <h5 class="text-uppercase fw-bold text-white mb-0">Technical Competencies</h5>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="grid-box p-3 h-100">
                                <h6 class="text-warning fw-bold mb-2">Backend &amp; Languages</h6>
                                <p class="text-light text-opacity-75 small mb-0 lh-base">
                                    C#, .NET 8 / .NET Core, ASP.NET MVC 5, Web API REST Services, LINQ, Asynchronous Programming &amp; File I/O, Dependency Injection, Microservices Architecture, Unit Testing.
                                </p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="grid-box p-3 h-100">
                                <h6 class="text-warning fw-bold mb-2">Database &amp; Data Engineering</h6>
                                <p class="text-light text-opacity-75 small mb-0 lh-base">
                                    Microsoft SQL Server, Entity Framework Core, LINQ-to-Entities, SQL Performance Tuning, Complex Joins, Schema Migrations, Stored Procedures, Database Restore &amp; User Mapping Management.
                                </p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="grid-box p-3 h-100">
                                <h6 class="text-warning fw-bold mb-2">DevOps, Cloud &amp; Automation</h6>
                                <p class="text-light text-opacity-75 small mb-0 lh-base">
                                    Docker Containers, Azure App Services, Azure DevOps Pipelines, GitHub Actions Workflows, CI/CD Pipeline Engineering, Octopus Deploy, Tidal Enterprise Job Scheduler, ServiceNow Ticket Management.
                                </p>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="grid-box p-3 h-100">
                                <h6 class="text-warning fw-bold mb-2">Frontend, Logging &amp; Tools</h6>
                                <p class="text-light text-opacity-75 small mb-0 lh-base">
                                    Razor Pages, HTML5/CSS3, JavaScript (ES6+), Bootstrap 5, XAML, Log4net, Structured Global Error Handling Middleware, Git Source Control, Visual Studio 2022, SSMS.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Professional Experience -->
                <div class="mb-5">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="section-icon">
                            <i class="bi bi-briefcase-fill fs-5"></i>
                        </div>
                        <h5 class="text-uppercase fw-bold text-white mb-0">Professional Experience</h5>
                    </div>
                    <div class="grid-box p-4">
                        <div class="d-flex flex-wrap justify-content-between align-items-baseline mb-2">
                            <div>
                                <h6 class="text-white fw-bold mb-0 fs-5">Chief Technology Officer &amp; Co-Founder</h6>
                                <span class="text-primary fw-semibold small" style="color: #38bdf8 !important;">ASpynix &bull; Product Architecture &amp; Engineering</span>
                            </div>
                            <span class="badge bg-secondary bg-opacity-50 text-light px-3 py-2 rounded-pill small">2025 &ndash; Present</span>
                        </div>
                        <ul class="text-light text-opacity-75 small mb-0 ps-3 lh-lg">
                            <li>Direct overall technical vision, software engineering lifecycles, and architectural governance across full-stack .NET and database initiatives.</li>
                            <li>Engineered enterprise-grade microservice and monolithic backends using ASP.NET Core and Microsoft SQL Server, reducing API latency and securing multi-tenant data workflows.</li>
                            <li>Constructed end-to-end automated deployment systems via GitHub Actions and Docker containers for continuous, zero-downtime application delivery.</li>
                            <li>Designed custom dependency injection models, robust asynchronous I/O managers, and central structured logging middleware with Log4net and Serilog.</li>
                        </ul>
                    </div>
                </div>

                <!-- Enterprise Projects -->
                <div class="mb-5">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="section-icon">
                            <i class="bi bi-diagram-3-fill fs-5"></i>
                        </div>
                        <h5 class="text-uppercase fw-bold text-white mb-0">Enterprise Projects &amp; Deployments</h5>
                    </div>

                    <div class="grid-box p-3 mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-white fw-bold">PANKH &ndash; Enterprise Cloud Management Portal</span>
                            <span class="badge bg-primary bg-opacity-20 text-primary small">Azure Web Apps</span>
                        </div>
                        <p class="text-light text-opacity-75 small mb-2">
                            Engineered an automated web management application leveraging ASP.NET Core and Entity Framework Core. Integrated CI/CD automation via GitHub Workflows and deployed with high-availability configurations on Microsoft Azure.
                        </p>
                        <div class="text-secondary small">
                            <strong>Technologies:</strong> ASP.NET Core, C#, Azure DevOps, GitHub Actions, SQL Server
                        </div>
                    </div>

                    <div class="grid-box p-3 mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-white fw-bold">URVI &ndash; Food &amp; Grocery Delivery Platform Architecture</span>
                            <span class="badge bg-info bg-opacity-20 text-info small">System Architecture</span>
                        </div>
                        <p class="text-light text-opacity-75 small mb-2">
                            Architected complete relational database models, C# API controllers, and client layouts in XAML. Configured real-time order processing pipelines, item catalog indexing, and resilient cart state managers.
                        </p>
                        <div class="text-secondary small">
                            <strong>Technologies:</strong> .NET Web API, C#, XAML, Relational Database Modeling, JSON Data Services
                        </div>
                    </div>

                    <div class="grid-box p-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-white fw-bold">High-Performance Portfolio &amp; System Showcase</span>
                            <span class="badge bg-success bg-opacity-20 text-success small">Docker &amp; Linux Cloud</span>
                        </div>
                        <p class="text-light text-opacity-75 small mb-2">
                            Built and containerized a responsive .NET 8 Razor Pages portfolio engine using multi-stage Docker builds. Features optimized asset pipelines, zero-downtime cloud hosting, and integrated ATS document generation.
                        </p>
                        <div class="text-secondary small">
                            <strong>Technologies:</strong> .NET 8, Docker Multi-Stage, Razor Pages, Bootstrap 5, Cloud Host
                        </div>
                    </div>
                </div>

                <!-- Education -->
                <div>
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="section-icon">
                            <i class="bi bi-mortarboard-fill fs-5"></i>
                        </div>
                        <h5 class="text-uppercase fw-bold text-white mb-0">Education &amp; Credentials</h5>
                    </div>
                    <div class="grid-box p-3 d-flex flex-wrap justify-content-between align-items-center">
                        <div>
                            <h6 class="text-white fw-bold mb-1">Bachelor of Science in Information Technology (B.Sc. IT)</h6>
                            <p class="text-secondary small mb-0">Specialized in Object-Oriented Software Engineering, Data Structures, Relational Database Systems &amp; Web Architectures.</p>
                        </div>
                        <span class="badge bg-secondary px-3 py-2 rounded-pill mt-2 mt-md-0">Graduated</span>
                    </div>
                </div>

            </div>
        </div>
    </div>

</body>
</html>